setcpm(140/4)

const PatternProto = Object.getPrototypeOf(reify("0"));

PatternProto.pluck = function (from, to = from) {
  if (from < 1 || to < from) {
    return reify("~");
  }

  const start = from - 1;
  const len   = to - from + 1;
  return this.drop(start).take(len);
};

const head = "0 4"
const tail = "8 9 13"

const a = stepcat(head, tail)
const b = stepcat(a.take(1).add(7), a.pluck(3), tail)
const c = b.take(3).add("-7 0 0")
const d = a.add(1)
const e = b.add(1)
const f = d.take(-4)
const g = stepcat("3", d.pluck(3, 4), tail.take(2).add(7))

const phrase = stepcat(a, b, c, d, e, f, g)

$: n(phrase)
  .scale("c2:major")
  .pace(16)
  .s("gm_piano").orbit(2)
  .room(1).size(0.9)
  ._pianoroll()

$: stack(
  s("bd").struct("1@5  ~@5  1@3  1@5  ~@5  1@3 1  ~@2 1@3"),
  s("sd").struct("~@5  1@5  ~@3  ~@5  1@5  ~@4  1@3 1 1"),
  s("hh").struct("1@2 1 1@2  1@2 1 1@2  1@2 1  1@2 1 1@2  ~@2 1 1@2  1@2 1 1  ~@2 1 1@2")
).pace(16).bank("tr909")

$: n(phrase.filterValues(v => v < 7))
  .scale("c1:major")
  .pace(16)
  .s("gm_fretless_bass")`,
