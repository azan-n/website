---
import PostLayout from "../../../components/PostLayout.astro";
import { Image } from "astro:assets";
import cover from "./20230319-4.png";
import img1 from "./20230319-1.png";
import img2 from "./20230319-2.png";
import img3 from "./20230319-3.png";
import img5 from "./20230319-5.png";
import img6 from "./20230319-6.png";
import img7 from "./20230319-7.png";
import img8 from "./20230319-8.png";
import img9 from "./20230319-9.png";
import img10 from "./20230319-10.png";

export const meta = {
  title: "Ordering food in flights",
  date: new Date(2023, 2, 19),
